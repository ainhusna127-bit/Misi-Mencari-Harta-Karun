document.querySelectorAll("#hub .door").forEach(b=>b.onclick=()=>{if(lock||done.has(b.dataset.k))return;lock=true;const r=b.getBoundingClientRect();$("hh").style.transform=`translateX(calc(-50% + ${r.left+r.width/2-innerWidth/2}px)) translateY(-26vh) scale(.5)`;setTimeout(()=>{ss=0;cur=b.dataset.k;qs=[0,1,2].map(i=>({s:cur,t:{mata:"car",hidung:"cat",telinga:"pk"}[cur],i,g:1}));qi=0;show("game");load()},950)});
function load(){lock=false;const q=qs[qi];document.body.dataset.t=q.s;const R=lvl=="r"||q.g;$("act").style.display=R?"flex":"none";document.querySelector(".q").style.display=R?"none":"";$("opts").style.display=R?"none":"";$("av").innerHTML=hero(g);$("sc").textContent="⭐ "+sc;$("pb").style.width=(qi/qs.length*100)+"%";
$("tag").innerHTML=q.g?{car:'🚗 Pandu Ikut Deria',cat:'🧺 Tangkap Deria',pk:'🌉 Jambatan Hutan'}[q.t]:'<svg class="ti" viewBox="0 0 64 64">'+ICON[SD[q.s].i]+'</svg> '+N[q.s];$("tag").className="tag "+q.s;$("qt").textContent=q.t;$("qb").textContent=q.b;$("msg").textContent="";if(R)return loadR(q);
$("snd").style.display=q.f?"inline-block":"none";$("snd").onclick=()=>tone(q.f);if(q.f)setTimeout(()=>tone(q.f),300);
$("opts").innerHTML="";const keep=lvl=="r"&&q.o.length>2?[q.a,q.o.findIndex((_,x)=>x!=q.a)].sort():[...q.o.keys()];keep.forEach(k=>{const t=q.o[k],b=document.createElement("button");b.className="opt";b.textContent=t;b.dataset.k=k;b.onclick=()=>pick(b,k);$("opts").appendChild(b)});if(lvl=="r")speak(q.t)}
function pick(b,k){if(lock)return;lock=true;const q=qs[qi],bs=[...$("opts").children];
if(k==q.a){b.classList.add("ok");sc++;ss++;burst(26);if(lvl=="r")speak("Pandai!");$("msg").textContent="Pandai, "+nm+"! 🎉";$("av").classList.add("b")}
else if(lvl=="r"){b.classList.add("no");b.disabled=true;lock=false;bs.find(x=>x.dataset.k==q.a).classList.add("hint");$("msg").textContent="Cuba lagi! 😊";return}else{b.classList.add("no");bs.find(x=>x.dataset.k==q.a).classList.add("ok");$("msg").textContent="Cuba lagi nanti! 💪"}
$("sc").textContent="⭐ "+sc;setTimeout(()=>{qi++;if(qi<qs.length)return load();done.add(cur);keyGot(()=>done.size==3?fin():hub())},1400)}
function fin(){burst(70);$("ea").innerHTML=hero(g);$("et").textContent="🏆 Tahniah, "+nm+"! 🏆";$("es").innerHTML=Array.from({length:9},(_,i)=>`<span class="sx${i<sc?"":" off"}" style="animation-delay:${i*.12}s">⭐</span>`).join("");$("ep").textContent="Skor kamu: "+sc+" / "+Q.length;show("end");setTimeout(()=>{speak("Yey! Dapat harta karun!");jingle()},500)}

/* ===== Bunyi: muzik latar + "tit" ===== */
let MU=null,mg=null,muted=false;
function getAC(){ac=ac||new (window.AudioContext||window.webkitAudioContext)();if(ac.state=="suspended")ac.resume();return ac}
function tit(){try{const c=getAC(),t=c.currentTime,o=c.createOscillator(),n=c.createGain();o.type="square";o.frequency.setValueAtTime(1500,t);o.connect(n);n.connect(c.destination);n.gain.setValueAtTime(.07,t);n.gain.exponentialRampToValueAtTime(.001,t+.08);o.start(t);o.stop(t+.09)}catch(e){}}
const MN={C3:130.81,A2:110,F2:87.31,G2:98,C4:261.63,D4:293.66,E4:329.63,F4:349.23,G4:392,A4:440,C5:523.25,D5:587.33,E5:659.25,G5:783.99};
const ML="E4 G4 C5 G4 E4 G4 A4 G4 E4 A4 C5 A4 E4 A4 G4 E4 A4 C5 D5 C5 A4 C5 A4 G4 G4 D5 E5 D5 G4 D5 C5 D5".split(" "),MB=["C3","A2","F2","G2"];
function note(f,t,d,v,ty){const c=ac,o=c.createOscillator(),n=c.createGain();o.type=ty;o.frequency.value=f;o.connect(n);n.connect(mg);n.gain.setValueAtTime(0,t);n.gain.linearRampToValueAtTime(v,t+.02);n.gain.exponentialRampToValueAtTime(.001,t+d);o.start(t);o.stop(t+d+.02)}
function startMusic(){if(MU)return;try{const c=getAC();mg=c.createGain();mg.gain.value=muted?0:1;mg.connect(c.destination);let st=0,nt=c.currentTime+.1;
MU=setInterval(()=>{if(nt<c.currentTime)nt=c.currentTime+.05;while(nt<c.currentTime+.7){const i=st%32;note(MN[ML[i]],nt,.28,.045,"triangle");if(i%4==0)note(MN[MB[(i>>3)%4]],nt,.55,.06,"sine");nt+=.3;st++}},150)}catch(e){MU=null}}
document.addEventListener("pointerdown",e=>{startMusic();if(e.target.closest&&e.target.closest("button,.door,.gt,.opt,.lv,.kd,.sn"))tit()},true);
const mt=document.createElement("button");mt.className="bk";mt.id="mt";mt.textContent="🎵";mt.title="Muzik";mt.style.cssText="position:fixed;right:10px;top:10px;z-index:30;padding:.25em .6em";
mt.onclick=()=>{muted=!muted;mt.textContent=muted?"🔇":"🎵";if(mg)mg.gain.setTargetAtTime(muted?0:1,ac.currentTime,.05)};document.body.appendChild(mt);
$("hnt").onclick=()=>speak("Pilih pintu");
function keyGot(cb){const o=document.createElement("div");o.className="kgo";o.innerHTML=`<div class="kgc"><div class="rays"></div><div class="kgs" style="--o:min(30vw,22vh);${ov(cur)}"><span class="orb">${icn(SD[cur].i)}</span><b class="key kg2">🔑</b></div><p>Yey! Dapat kunci ${SD[cur].n}! 🎉</p></div>`;document.body.appendChild(o);burst(40);jingle();speak("Yey! Dapat kunci!");let d=0;const end=()=>{if(d)return;d=1;o.remove();cb()};o.onclick=end;setTimeout(end,2800)}
function jingle(){try{const c=getAC(),t=c.currentTime;[784,988,1175,1568,1976].forEach((f,i)=>{const o=c.createOscillator(),n=c.createGain(),b=t+i*.09;o.type="triangle";o.frequency.value=f;o.connect(n);n.connect(c.destination);n.gain.setValueAtTime(0,b);n.gain.linearRampToValueAtTime(.1,b+.01);n.gain.exponentialRampToValueAtTime(.001,b+.35);o.start(b);o.stop(b+.4)})}catch(e){}}
$("ch2").onclick=()=>{speak("Yey! Dapat harta karun!");jingle()};
$("ms").onclick=$("chest").onclick=()=>speak("Misi mencari harta karun! Cari tiga kunci deria, kemudian buka peti harta karun.");
